{
  "description": "A posted entry reversed: previewed, confirmed, never edited.",
  "settings": "[company]\nname = \"Eval Co\"\nfiscal_year_start = \"01-01\"\n[books]\ncash_accounts = [\"1000\"]\n",
  "setup": [
    {
      "call": "books.add_account",
      "args": {
        "code": "1000",
        "name": "Cash",
        "account_type": "asset"
      }
    },
    {
      "call": "books.add_account",
      "args": {
        "code": "3000",
        "name": "Capital",
        "account_type": "equity"
      }
    },
    {
      "call": "books.add_account",
      "args": {
        "code": "6000",
        "name": "Rent",
        "account_type": "expense"
      }
    }
  ],
  "steps": [
    {
      "call": "books.start",
      "args": {}
    },
    {
      "follow": "books.draft_entry",
      "with": {
        "date": "2026-01-10",
        "description": "Coffee beans",
        "no_party_reason": "test"
      }
    },
    {
      "follow": "books.add_line",
      "with": {
        "account": "6000",
        "side": "debit",
        "amount": "10.00"
      }
    },
    {
      "follow": "books.add_line",
      "with": {
        "account": "1000",
        "side": "credit",
        "amount": "10.00"
      }
    },
    {
      "follow": "books.post_entry",
      "with": {}
    },
    {
      "follow": "books.post_entry",
      "with": {}
    },
    {
      "expect": {
        "/status": "posted"
      }
    },
    {
      "follow": "books.reverse_entry",
      "with": {
        "date": "2026-01-11",
        "description": "Reverse: entered in error"
      }
    },
    {
      "expect": {
        "/status": "preview"
      }
    },
    {
      "follow": "books.reverse_entry",
      "with": {}
    },
    {
      "expect": {
        "/status": "posted"
      }
    }
  ]
}
